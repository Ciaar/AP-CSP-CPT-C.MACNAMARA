import pygame #This imports the pygame module which would be helpful with images and such
import random #Imports random which is to help with picking random times in the case of my project 

pygame.init()#This initalizes the imported pygame module
#This sets the screen dimensions
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
#This part creates the game window and gives it the caption title of "Reaction Time Tester"
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption('Reaction Time Tester')
font = pygame.font.SysFont(None, 50)#This sets the base font that will be used
#Function to display text on screen, used often throughout the code
def show_text(msg, color, x=SCREEN_WIDTH//2, y=SCREEN_HEIGHT//2):
    text = font.render(msg, True, color)
    screen.blit(text, (x, y))
#Defines each button for later use 
button = pygame.Rect((300, 350, 200, 200))#This is the react button
button_text = font.render("Button", True, (0, 0, 0))#Used to render the word "button" to be drawn on the screen
button0 = pygame.Rect (300, 350, 200, 200)#duplicate button used for interaction
play_button = pygame.Rect(300, 350, 200, 200)#This is the play again button
play_text = font.render("Play again", True, (0, 0, 0))#Used to render the words "play again" to be drawn on the screen
#game state variables
rxn_time = 0
run = True
completed = False
written = False
#starting screen which asks the user if they would like to play
def start ():
    asking = True
    #this part below defines yes and no buttons
    yes_button = pygame.Rect(200, 400, 150, 100)
    no_button = pygame.Rect(450, 400, 150, 100)
    yes_text = font.render("Yes", True, (0, 0, 0))
    no_text = font.render("No", True, (0, 0, 0))
    #loops until the user chooses
    while asking:
        screen.fill((30, 30, 30))#screenfills with a dark gray color but not too dark and not too bright 
        show_text("Would you like to play?", (255, 255, 255), 220, 200) #displays the text on the screen
        #below draws the buttons to be interacted with
        pygame.draw.rect(screen, (0, 255, 0), yes_button)#draws yes button in green
        pygame.draw.rect(screen, (255, 0, 0), no_button)#draws no button in red
        #writes yes and no on the buttons
        screen.blit(yes_text, (yes_button.x + 40, yes_button.y + 30))
        screen.blit(no_text, (no_button.x + 40, no_button.y + 30))
        #checks for user input 
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                #if the user closes the window it quits the game
                pygame.quit()
                exit()
            elif event.type == pygame.MOUSEBUTTONDOWN:
                #if the user clicked the mouse then check if one of the buttons were clicked
                if yes_button.collidepoint(pygame.mouse.get_pos()):
                    #if yes is clicked then exit loop and start game
                    asking = False
                elif no_button.collidepoint(pygame.mouse.get_pos()):
                    #if the no button is clicked then display a message and exit game
                    print("\nPlease comeback again later!")
                    pygame.quit()
                    exit()
            #refresh the screen to update if there are any changes
            pygame.display.update()
#function to run one round of the game
def play (diff):
    too_soon = False #checks and marks for early clicks
    too_soon_time = 0 #time when clicked too soon
    #load the times from the leaderboard file and sort them
    with open('leaderboard.txt', 'r') as file:
        numbers = [float(line.strip()) for line in file if line.strip()] 
    numbers.sort()
    #fill up only 5 leaderboard entries
    while len(numbers) < 5:
        numbers.append(float('inf'))#used as a place holder if there is no number to fill its place
    #take top 5 values
    p1, p2, p3, p4, p5 = numbers[:5]
    start_time = pygame.time.get_ticks()#record current time as start of round
    random_time = random.randint(3000,10000)//diff #choose a random wait time between a range before the button becomes clickable, changes with difficulty
    button_color = (255, 255, 255)#button starts as white
    #access global variables for tracking
    global run, completed, written, rxn_time, button_text
    #inner game loop
    while run:
        current_time = pygame.time.get_ticks()#get current time since start
        #if has clicked and completed the round
        if completed:
            screen.fill((50,215,250))#fill color with a light blue screen
            time_text = font.render("Your reaction time was: "+str(rxn_time/1000)+" seconds!", True, (255, 255, 255))#text surface to show reaction time in seconds
            screen.blit(time_text, (100, 250))#draw the time text on screen at specific position
            pygame.draw.rect(screen, (255, 255, 255), play_button) #draw the play again button in white
            screen.blit(play_text, (320, 460))#draw the play again text
        #the user is still in the round and waiting to click button
        else:         
            screen.fill((0, 0, 0))#screen fill with black
            imp = pygame.image.load("/Users/ciaran/downloads/table/table3.png")#load the image of the leaderboard from the computer files
            imp_resized = pygame.transform.scale(imp, (350,350))#resizing the leaderboard image
            screen.blit(imp_resized, (220,15))#draw the resized image onto screen at the specific points
            #Show the top 5 scores on screen in white at their specific locations whoch fit into the leaderboard spaces
            show_text(str(p1) + " s", (255, 255, 255), 355, 50)
            show_text(str(p2) + " s", (255, 255, 255), 355, 112)
            show_text(str(p3) + " s", (255, 255, 255), 355, 172)
            show_text(str(p4) + " s", (255, 255, 255), 355, 235)
            show_text(str(p5) + " s", (255, 255, 255), 355, 295)
            #calculate how long the user has waited
            elapsed_time = current_time - start_time
            #rest the too soon mark after one second
            if too_soon and current_time - too_soon_time > 1000:
                too_soon = False
            #change the button color based on the time in the game and the state, whether the user clicked or not
            if elapsed_time > random_time and not too_soon:
                button_color = (0, 255, 0)#green when timegoes by and is able to be clicked
            elif too_soon:
                button_color = (255, 0, 0)#red when not enough time passes and it is clicked too soon
            else:
                button_color = (255, 255, 255)#white is when the button is waiting to either turn green or be clicked and turn red
            #Draw the clickable button
            pygame.draw.rect(screen, button_color, button)
            pygame.draw.rect(screen, button_color, button0)
            #Show either not yet or button depending on the state
            if too_soon:
                text_to_show = font.render("Not Yet", True, (0, 0, 0))
            else:
                text_to_show = button_text
            screen.blit(text_to_show, (340, 355))
        #checks for user inputs like quitting or clicking
        for event in pygame.event.get():
            #if the user clicks the window close button then closes the game
            if event.type == pygame.QUIT:
                return True
            #if the user clicks the mouse then get the mouse position
            elif event.type == pygame.MOUSEBUTTONDOWN:
                mouse_position=pygame.mouse.get_pos()
                #check if game is still in progress and the user clicked in the main button area
                if not completed and (button.collidepoint(mouse_position) or button0.collidepoint(mouse_position)):
                    #if the user clicked the button before turning green
                    if elapsed_time - random_time < 0:
                        too_soon=True #set marker for being clicked early
                        too_soon_time=current_time #record the time of the click
                    else:
                        #user clicked after the button turned green
                        rxn_time = elapsed_time - random_time #calculate reaction time
                        completed = True #mark round as completed
                        # if the reaction time hasn't been saved yet
                        if not written:
                            #open the leaderboard file and save new time
                            with open('leaderboard.txt', 'a') as file1:
                                file1.write('\n' + str(rxn_time / 1000)) #converts milliseconds to seconds
                                written = True #mark that the score has been recorded
                #play again button was clicked
                elif completed and play_button.collidepoint(mouse_position):
                    completed = False
                    written = False
                    rxn_time = 0
                    too_soon = False
                    pygame.display.update()
                    return False #restart the game
        #update the display to show the newer times
        pygame.display.update()
#call start screen
start ()
#set difficulty
difficulty=2
#main game loop which keeps restarting until the user exits
while True:
    quit = play(difficulty)
    if quit:
        break
#clean up and exit
pygame.quit()
exit()
